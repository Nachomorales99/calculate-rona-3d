{
  "name": "@rona3d/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Dominio compartido de Rona 3D: motor de cálculo, monedas, esquemas y formatters. Funciones puras, sin dependencias de UI ni de servidor.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rona3d/config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
